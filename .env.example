# COSMOW environment configuration
# Copy these settings into backend/.env and replace placeholders.
# Never commit real credentials.

ENVIRONMENT=development

# Local PostgreSQL development database — create it before use.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/cosmow_dev

# Authentication — replace with a strong random secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter — optional key; no paid fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
AI_MODEL=openrouter/free

# Gemini embeddings — optional key.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_TIMEOUT_SECONDS=15

# AI usage limits
DAILY_AI_REQUEST_LIMIT=5
GLOBAL_DAILY_AI_CALL_LIMIT=50

# Supabase authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_TIMEOUT_SECONDS=5
